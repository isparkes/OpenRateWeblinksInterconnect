<?xml version="1.0" encoding="UTF-8"?>
<assembly
  xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">

  <id>bin</id>

  <formats>
    <format>zip</format>
  </formats>

  <includeBaseDirectory>false</includeBaseDirectory>

  <dependencySets>
    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <outputDirectory>lib</outputDirectory>
      <excludes>
        <exclude>OpenRate:OpenRate</exclude>
      </excludes>
      <unpack>false</unpack>
    </dependencySet>

    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <outputDirectory>ORlib</outputDirectory>
      <includes>
        <include>OpenRate:OpenRate</include>
      </includes>
      <unpack>false</unpack>
    </dependencySet>
  </dependencySets>

  <fileSets>
    <!-- Put the application jar in the "dist" folder -->
    <fileSet>
      <directory>${project.build.directory}</directory>
      <outputDirectory>dist</outputDirectory>
      <includes>
        <include>*.jar</include>
      </includes>
      <excludes>
        <exclude>src/main/resources/*.*</exclude>
      </excludes>
    </fileSet>

    <!-- Launcher scripts for the unpacked distribution -->
    <fileSet>
      <directory>src/main/bin</directory>
      <outputDirectory>bin</outputDirectory>
      <fileMode>0755</fileMode>
      <includes>
        <include>*.sh</include>
      </includes>
    </fileSet>

    <!-- Documentation at the root of the distribution -->
    <fileSet>
      <directory>src/main/dist</directory>
      <outputDirectory>.</outputDirectory>
      <includes>
        <include>README.md</include>
      </includes>
    </fileSet>

    <!-- License at the root of the distribution -->
    <fileSet>
      <directory>.</directory>
      <outputDirectory>.</outputDirectory>
      <includes>
        <include>LICENSE</include>
      </includes>
    </fileSet>

    <!-- Sample input, so the distribution can be tried out as shipped.
         Two hours out of the full archive, which stays in the source tree
         because it is 65MB. -->
    <fileSet>
      <directory>src/main/dist/samples</directory>
      <outputDirectory>samples</outputDirectory>
      <includes>
        <include>*.csv.gz</include>
      </includes>
    </fileSet>

    <!-- The database schema and reference data the application needs -->
    <fileSet>
      <directory>src/main/db-backups</directory>
      <outputDirectory>db</outputDirectory>
      <includes>
        <include>WeblinksInterconnectDB.sql</include>
      </includes>
    </fileSet>

    <fileSet>
      <directory>ConfigData/WeblinksInterconnect</directory>
      <outputDirectory>db</outputDirectory>
      <includes>
        <include>SP-Procedure-Create.sql</include>
      </includes>
    </fileSet>

    <!-- Copy over all the config files we have -->
    <fileSet>
      <directory>src/main/resources</directory>
      <outputDirectory>properties</outputDirectory>
      <includes>
        <include>WeblinksInterconnect.properties.xml</include>
        <include>logWeblinksInterconnect.xml</include>
      </includes>
    </fileSet>

    <!-- Force the directories with descriptions -->
    <fileSet>
      <directory>src/main/resources</directory>
      <outputDirectory>Semaphore</outputDirectory>
      <includes>
        <include>Semaphore-Readme.txt</include>
      </includes>
    </fileSet>

    <fileSet>
      <directory>src/main/resources</directory>
      <outputDirectory>log</outputDirectory>
      <includes>
        <include>Log-Readme.txt</include>
      </includes>
    </fileSet>

    <fileSet>
      <directory>src/main/resources</directory>
      <outputDirectory>Data/WeblinksInterconnect</outputDirectory>
      <includes>
        <include>Data-Readme.txt</include>
      </includes>
    </fileSet>

    <!-- Copy over the Configuration files -->
    <fileSet>
      <directory>ConfigData/WeblinksInterconnect</directory>
      <outputDirectory>ConfigData/WeblinksInterconnect</outputDirectory>
      <includes>
        <include>aggregations.dat</include>
      </includes>
    </fileSet>

  </fileSets>
</assembly>
